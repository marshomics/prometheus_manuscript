# =====================================================================
# Prometheus-in-archaea: diversity, distribution, evolution, taxonomy,
# ecology. Snakemake implementation of the design in
# ../Prometheus_archaea_pipeline_design.md
#
# Run (Grid Engine):
#   snakemake --workflow-profile workflow/profiles/sge --use-conda --jobs 200
# Dry run / DAG check:
#   snakemake -n -p
# =====================================================================

include: "rules/common.smk"
include: "rules/preprocess.smk"
include: "rules/qc.smk"
include: "rules/prometheus.smk"
include: "rules/diversity.smk"
include: "rules/scaffolds.smk"
include: "rules/distribution.smk"
include: "rules/evolution.smk"
include: "rules/ecology.smk"
include: "rules/synthesis.smk"
include: "rules/plots_extra.smk"
include: "rules/crossdomain.smk"
include: "rules/disorder.smk"


rule all:
    input:
        all_targets()


rule disorder:
    """Opt-in intrinsic-disorder module (set disorder.enabled: true). Consensus disorder
    on intact Prometheus loci, anchored to the family alignment, compared across
    methanogens/niches/lineages (phylolm) and bacteria vs archaea when that branch is
    also on. Consumes archaeal proteins/catalog/alignment/tree read-only; the default
    `all` run is unaffected unless disorder.enabled."""
    input:
        disorder_targets()


rule crossdomain:
    """Opt-in bacterial / cross-domain branch (set bacteria.enabled: true). Reuses the
    archaeal validation/prevalence/architecture/selection/co-occurrence scripts on a
    pre-computed bacterial DefenseFinder set, and builds the combined cross-domain
    phylogeny (origin + bacteria<->archaea transfer direction). Does NOT alter the
    archaeal `all`/`preprocess` runs; it consumes the archaeal Prometheus proteins as a
    read-only input."""
    input:
        crossdomain_targets()


rule preprocess:
    """Phase 1: classify (GTDB-Tk, batched), QC (CheckM2 + BBMap), score, quality-filter,
    and collapse the raw genome set to one representative per GTDB species (unioning
    niche/group presence-absence). Run this BEFORE the analysis."""
    input:
        preprocess_targets()


rule provenance:
    """Record tool and database versions for reproducibility."""
    output:
        f"{RESULTS}/provenance/versions.txt"
    conda:
        "envs/qc.yaml"
    shell:
        r"""
        mkdir -p $(dirname {output})
        {{
          echo "# Prometheus pipeline provenance"
          date -u +"generated_utc=%Y-%m-%dT%H:%M:%SZ"
          echo "snakemake=$(snakemake --version 2>/dev/null || echo NA)"
          echo "conda=$(conda --version 2>/dev/null || echo NA)"
          for tool in checkm2 gtdbtk defense-finder mmseqs iqtree2 mafft clipkit \
                      generax hyphy genomad checkv hmmsearch seqkit drep prodigal; do
            v=$(command -v $tool >/dev/null 2>&1 && ($tool --version 2>&1 | head -n1) || echo "not-on-PATH-here")
            echo "$tool=$v"
          done
          # DefenseFinder models version (the Prometheus model needs models >= 2.0.0).
          echo "defense-finder-models=$(command -v macsydata >/dev/null 2>&1 && (macsydata info defense-finder-models 2>/dev/null | grep -i -m1 version || echo unknown) || echo macsydata-not-on-PATH)"
        }} > {output}
        """
